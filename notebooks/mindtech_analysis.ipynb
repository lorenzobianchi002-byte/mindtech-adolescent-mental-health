    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Prova prima il percorso standard o diretto\n",
    "try:\n",
    "    df = pd.read_csv('../data/Teen_Mental_Health_Dataset.csv')\n",
    "except FileNotFoundError:\n",
    "    try:\n",
    "        df = pd.read_csv('data/Teen_Mental_Health_Dataset.csv')\n",
    "    except FileNotFoundError:\n",
    "        df = pd.read_csv('Teen_Mental_Health_Dataset.csv')\n",
    "\n",
    "print(\"=== 1. STRUTTURA E ORGANIZZAZIONE DEL DATASET ===\")\n",
    "print(f\"Dimensioni della matrice: {df.shape[0]} righe (soggetti), {df.shape[1]} colonne (variabili)\")\n",
    "print(\"\\nTipi di dati e colonne:\")\n",
    "print(df.dtypes)\n",
    "\n",
    "print(\"\\n=== 2. VERIFICA DELL'INTEGRITÀ E CREDIBILITÀ DEI DATI ===\")\n",
    "missing_values = df.isnull().sum().sum()\n",
    "duplicates = df.duplicated().sum()\n",
    "print(f\"Valori mancanti totali (Null): {missing_values}\")\n",
    "print(f\"Record duplicati totali: {duplicates}\")\n",
    "print(\"Esito audit: Dataset perfettamente pulito, senza valori nulli o duplicati, garantendo un'elevata affidabilità della fonte.\")\n",
    "\n",
    "print(\"\\n=== 3. STATISTICHE DESCRITTIVE PRELIMINARI ===\")\n",
    "print(df[['age', 'daily_social_media_hours', 'sleep_hours', 'stress_level']].describe())\n",
    "\n",
    "print(\"\\n=== 4. ORDINAMENTO E FILTRAGGIO AVANZATO ===\")\n",
    "heavy_users = df.sort_values(by='daily_social_media_hours', ascending=False).head(10)\n",
    "print(\"\\nTop 10 Heavy Users (maggior numero di ore sui social):\")\n",
    "print(heavy_users[['age', 'daily_social_media_hours', 'sleep_hours', 'stress_level', 'depression_label']])\n",
    "\n",
    "at_risk_group = df[(df['sleep_hours'] <= 5) & (df['stress_level'] >= 7)]\n",
    "print(f\"\\nNumero di soggetti nella fascia a rischio (sonno <= 5h e stress >= 7): {len(at_risk_group)}\")\n",
    "print(\"Media ore social nel gruppo a rischio:\", round(at_risk_group['daily_social_media_hours'].mean(), 2))\n",
    "print(\"Percentuale con indicatori di depressione nel gruppo a rischio:\", round(at_risk_group['depression_label'].mean() * 100, 2), \"%\")"
   ]
